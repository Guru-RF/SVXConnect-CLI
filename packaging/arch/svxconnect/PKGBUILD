# Maintainer: Joeri Van Dooren <ure@on6ure.be>

pkgname=svxconnect
pkgver=0.1.4
pkgrel=1
pkgdesc='Terminal client for SvxLink reflectors'
arch=('x86_64' 'aarch64')
url='https://github.com/Guru-RF/SVXConnect-CLI'
# miniaudio is vendored and compiled in: public domain (Unlicense) or MIT-0.
license=('MIT' 'MIT-0 OR Unlicense')
# miniaudio dlopen()s libasound.so.2 rather than linking it, so nothing would
# pull alsa-lib in and the package would install with no audio at all.
depends=('glibc' 'openssl' 'opus' 'ncurses' 'alsa-lib')
makedepends=('pkgconf')
optdepends=('libpulse: PulseAudio / pipewire-pulse audio backend')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4ff88eac5f9f255c1e8d28f2ccf18d7068f1f59ce7a164d6164afdb810015a1f')

_srcdir="SVXConnect-CLI-$pkgver"

prepare() {
  cd "$_srcdir"
  # The unit is written for `make install` into /usr/local.
  sed -i 's#/usr/local/bin/svxconnect#/usr/bin/svxconnect#' packaging/systemd/svxconnect@.service
  # The man page names the Debian doc path, where example.conf is gzipped.
  sed -i 's#example\.conf\.gz#example.conf#' debian/svxconnect.1
}

build() {
  cd "$_srcdir"
  # makepkg's CFLAGS replace the Makefile's default, -std=gnu11 included, and
  # GCC 15+ would otherwise compile as gnu23.
  make CFLAGS="$CFLAGS -std=gnu11" PREFIX=/usr
}

check() {
  cd "$_srcdir"
  make CFLAGS="$CFLAGS -std=gnu11" test
}

package() {
  cd "$_srcdir"
  make DESTDIR="$pkgdir" PREFIX=/usr install

  install -Dm644 debian/svxconnect.1 "$pkgdir/usr/share/man/man1/svxconnect.1"
  install -Dm644 packaging/systemd/svxconnect@.service \
    "$pkgdir/usr/lib/systemd/system/svxconnect@.service"

  # The system user the unit runs as (DEPLOY.md creates it by hand).
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/svxconnect.conf" <<'EOF'
u svxconnect - "SVXConnect reflector node" /var/lib/svxconnect
m svxconnect audio
EOF

  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" \
    README.md DEPLOY.md example.conf docs/PTT.md
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    LICENSE THIRD-PARTY-NOTICES
}
