# Maintainer: Joeri Van Dooren <ure@on6ure.be>

# Repackages the svxconnect package attached to the GitHub release, built from
# packaging/arch/svxconnect with the same PKGBUILD.

pkgname=svxconnect-bin
_pkgname=svxconnect
pkgver=0.1.4
pkgrel=1
_pkgrel=1
pkgdesc='Terminal client for SvxLink reflectors (prebuilt)'
arch=('x86_64')
url='https://github.com/Guru-RF/SVXConnect-CLI'
license=('MIT' 'MIT-0 OR Unlicense')
depends=('glibc' 'openssl' 'opus' 'ncurses' 'alsa-lib')
optdepends=('libpulse: PulseAudio / pipewire-pulse audio backend')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-$_pkgrel-x86_64.pkg.tar.zst")
noextract=("$_pkgname-$pkgver-$_pkgrel-x86_64.pkg.tar.zst")
sha256sums=('8080a89d18d3c9b1609343f4c9a62f87949369d12e5a2b46002e5484d6b2e08b')

package() {
  bsdtar -xf "$_pkgname-$pkgver-$_pkgrel-x86_64.pkg.tar.zst" -C "$pkgdir" \
    --exclude .PKGINFO --exclude .BUILDINFO --exclude .MTREE
  mv "$pkgdir/usr/share/licenses/$_pkgname" "$pkgdir/usr/share/licenses/$pkgname"
}
